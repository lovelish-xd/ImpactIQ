<?xml version="1.0" encoding="UTF-8"?>

<FLOW VERSION="3.0" CLEANUP="true">

  <!-- nodes -->

<SEQUENCE TIMEOUT="" EXIT-ON="SUCCESS">
  <COMMENT>--main--</COMMENT>

  <!-- nodes -->

<SEQUENCE TIMEOUT="" EXIT-ON="FAILURE">
  <COMMENT>--try block--</COMMENT>

  <!-- nodes -->

<INVOKE TIMEOUT="" SERVICE="Default.clov3021.flows:notification_orderDoc" VALIDATE-IN="$none" VALIDATE-OUT="$none">
  <COMMENT></COMMENT>
</INVOKE>

<INVOKE TIMEOUT="" SERVICE="Default.clov3021.flows:billing_orderDoc" VALIDATE-IN="$none" VALIDATE-OUT="$none">
  <COMMENT></COMMENT>
</INVOKE>
</SEQUENCE>

<SEQUENCE TIMEOUT="" EXIT-ON="DONE">
  <COMMENT>--catch block--</COMMENT>

  <!-- nodes -->

<INVOKE TIMEOUT="" SERVICE="pub.flow:getLastError" VALIDATE-IN="$none" VALIDATE-OUT="$none">
  <COMMENT>--catching last error--</COMMENT>
</INVOKE>

<EXIT FROM="$flow" SIGNAL="SUCCESS" FAILURE-MESSAGE="">
  <COMMENT>--exiting from flow--</COMMENT>
</EXIT>
</SEQUENCE>
</SEQUENCE>
</FLOW>
